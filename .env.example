# --- App ---
# Public base URL of the app (e.g. https://dashboard.example.com)
NEXT_PUBLIC_APP_URL=

# --- Database ---
# Postgres/Neon connection string. Leave empty to use local PGlite at ./.data/pglite
DATABASE_URL=

# --- Auth ---
# Single-user passcode used on /login
DASHBOARD_PASSCODE=
# Secret for signing the session JWT (>= 32 chars)
SESSION_SECRET=
# Key for encrypting OAuth refresh tokens at rest (any random string; falls back to SESSION_SECRET if empty)
TOKEN_ENCRYPTION_KEY=
# Bearer secret for /api/sync/* (GitHub Actions / cron)
SYNC_SECRET=

# --- Google (Calendar + Drive) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Todoist ---
TODOIST_API_TOKEN=

# --- FTUGate (student portal) ---
FTU_USERNAME=
FTU_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Web Push (VAPID keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
